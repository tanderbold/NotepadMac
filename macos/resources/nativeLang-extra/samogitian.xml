<?xml version="1.0" encoding="UTF-8"?>
<!-- What the macOS port says and Windows does not: read beside PowerEditor/installer/nativeLang/samogitian.xml.
     english is the text as the port has it; text is what is shown. An Item left out stays English. -->
<NativeLangExtra name="Samogitian">
    <Item english="ASCII -&gt; HEX" text="ASCII -&gt; HEX"/>
    <Item english="HEX -&gt; ASCII" text="HEX -&gt; ASCII"/>
    <!-- Tools: Hashes, Base, Password -->
    <Item english="Base" text="Base"/>
    <Item english="Base64…" text="Base64…"/>
    <Item english="Base58…" text="Base58…"/>
    <Item english="Base32…" text="Base32…"/>
    <!-- Selected numbers (editor context menu) -->
    <Item english="Copy" text="Pasdaugeantea"/>
</NativeLangExtra>
