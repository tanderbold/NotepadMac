<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Replaces the upstream javascript_function parser.

    What the original does: it finds `function` in its various forms and groups
    methods under their class, which is right as far as it goes. What it does not
    find is an arrow function bound to a name — `const f = (x) => x` — which is
    how a great deal of modern JavaScript is written.

    What this does: the same, with arrow functions added. Everything else is kept
    as upstream has it.
-->
<NotepadPlus>
    <functionList>
        <parser
            displayName="JavaScript"
            id         ="javascript_function"
            commentExpr="(?s:/\*.*?\*/)|(?m-s://.*?$)"
        >
            <classRange
                mainExpr    ="^\h*(?:export\s+)?(?:default\s+)?class\s+[^\{]*\{"
                openSymbole ="\{"
                closeSymbole="\}"
            >
                <className>
                    <nameExpr expr="class\s+\K[A-Za-z_$][\w$]*" />
                </className>
                <function
                    mainExpr="^\h*(?:(?:static|async|get|set)\s+)*(?!(?:if|for|while|switch|catch|return|function|new)\b)\K[A-Za-z_$][\w$]*\s*\([^()]*\)\s*\{"
                >
                    <functionName>
                        <funcNameExpr expr="[A-Za-z_$][\w$]*" />
                    </functionName>
                </function>
            </classRange>
            <function
                mainExpr="(?:^\h*(?:export\s+(?:default\s+)?)?(?:async\s+)?function\s*\*?\s*\K[A-Za-z_$][\w$]*)|(?:^\h*(?:export\s+)?(?:const|let|var)\s+\K[A-Za-z_$][\w$]*(?=\s*=\s*(?:async\s*)?(?:function\b|\([^()]*\)\s*=&gt;|[A-Za-z_$][\w$]*\s*=&gt;)))"
            >
                <functionName>
                    <nameExpr expr="[A-Za-z_$][\w$]*" />
                </functionName>
            </function>
        </parser>
    </functionList>
</NotepadPlus>
